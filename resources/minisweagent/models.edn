;; Defaults per provider (the prefix of a model name) and per model id.
;; Prices are USD per million tokens; :cache-write and :cache-read default
;; to 1.25x and 0.1x of :input.
{:providers
 {"anthropic" {:api :anthropic
               :base-url "https://api.anthropic.com/v1"
               :api-key-env "ANTHROPIC_API_KEY"
               :params {:max_tokens 16000
                        ;; Caches the conversation prefix on every call.
                        :cache_control {:type "ephemeral"}}}
  "openai" {:api :openai
            :base-url "https://api.openai.com/v1"
            :api-key-env "OPENAI_API_KEY"}
  "openrouter" {:api :openai
                :base-url "https://openrouter.ai/api/v1"
                :api-key-env "OPENROUTER_API_KEY"
                ;; OpenRouter reports the cost of each call.
                :params {:usage {:include true}}}}

 :models
 {"claude-fable-5-1" {:price {:input 10.0 :output 50.0 :cache-read 0.25}
                      ;; A request declined by the safety classifiers is re-run
                      ;; on the model Anthropic recommends for its category.
                      :params {:fallbacks "default"}
                      :headers {"anthropic-beta" "server-side-fallback-2026-07-01"}}
  "claude-fable-5" {:price {:input 10.0 :output 50.0}}
  "claude-opus-5-5" {:price {:input 4.0 :output 20.0 :cache-read 0.2}
                     ;; Opus 5.5 defaults to medium effort.
                     :params {:fallbacks "default"
                              :output_config {:effort "high"}}
                     :headers {"anthropic-beta" "server-side-fallback-2026-07-01"}}
  "claude-opus-5" {:price {:input 5.0 :output 25.0}
                   :params {:fallbacks "default"}
                   :headers {"anthropic-beta" "server-side-fallback-2026-07-01"}}
  "claude-opus-4-8" {:price {:input 5.0 :output 25.0}}
  "claude-opus-4-7" {:price {:input 5.0 :output 25.0}}
  "claude-opus-4-6" {:price {:input 5.0 :output 25.0}}
  "claude-sonnet-5" {:price {:input 2.0 :output 10.0}}
  "claude-sonnet-4-6" {:price {:input 3.0 :output 15.0}}
  "claude-haiku-4-5" {:price {:input 1.0 :output 5.0}}}}
